# Copy this file to backend/.env and fill in the values.
# This file sits next to manage.py, NOT inside the config/ folder.

# --- Core Django -----------------------------------------------------
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Frontend origin (for CORS/CSRF) ----------------------------------
FRONTEND_URL=http://localhost:3000

# --- Database ----------------------------------------------------------
# LOCAL: point this at the Postgres db you created in Phase 1:
#   sudo -u postgres psql -c "CREATE DATABASE hiroshyma_dev;"
#   sudo -u postgres psql -c "CREATE USER hiroshyma_user WITH PASSWORD 'devpassword';"
#   sudo -u postgres psql -c "GRANT ALL PRIVILEGES ON DATABASE hiroshyma_dev TO hiroshyma_user;"
DATABASE_URL=postgres://hiroshyma_user:devpassword@localhost:5432/hiroshyma_dev

# PRODUCTION (Render): replace with the connection string Neon gives you,
# it will look like:
# DATABASE_URL=postgres://user:pass@ep-xxxx.region.aws.neon.tech/hiroshyma?sslmode=require

# --- Cloudinary (image storage) -----------------------------------------
# Leave these three blank for local development -- if CLOUDINARY_CLOUD_NAME
# is empty, settings_additions.py skips Cloudinary and Django falls back to
# saving uploaded images to backend/media/ on your own disk instead, which
# is exactly what you want while testing locally.
#
# Sign up free at cloudinary.com, then find these three values on your
# Cloudinary dashboard home page under "Product Environment Credentials".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
